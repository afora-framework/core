{
	"name": "afora-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "bun run.ts",
		"bench:guard": "bun run.ts --guard",
		"bench:check": "bun run.ts --check",
		"codspeed": "bun build ../src/index.ts --outfile .dist/afora.js --target node --format esm --packages external && node codspeed.ts",
		"typia": "ttsc -p typia/tsconfig.json"
	},
	"devDependencies": {
		"@codspeed/tinybench-plugin": "^6.1.1",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"arktype": "^2.2.9",
		"effect": "^4.1.3",
		"joi": "^18.3.2",
		"mitata": "^1.0.34",
		"tinybench": "^6.2.3",
		"ttsc": "^0.36.4",
		"typebox": "^1",
		"typescript": "7.0.2",
		"typia": "^15.3.1",
		"valibot": "^1.5.0",
		"yup": "^1.7.1",
		"zod": "^4.6.7"
	}
}
