{
	"$schema": "../../packages/codegen/afora.schema.json",
	"version": 1,
	"name": "blog",
	"output": {
		"dir": "src/domain"
	},
	"providers": {
		"database": {
			"import": "../provider.ts#database"
		}
	},
	"provider": "database",
	"environments": {
		"Database": {
			"fields": {
				"BLOG_DB": "string?"
			}
		}
	},
	"properties": {
		"Title": {
			"base": "string",
			"with": {
				"min": 3,
				"max": 120,
				"description": "A post title"
			}
		},
		"Status": {
			"enum": ["draft", "published"]
		}
	},
	"entities": {
		"User": {
			"fields": {
				"name": "text"
			},
			"plugins": ["authenticatable"]
		},
		"Post": {
			"fields": {
				"title": "Title",
				"content": "text",
				"status": "Status",
				"author": "User"
			},
			"change": ["status"],
			"plugins": ["taggable", "publishable"]
		}
	},
	"repositories": {
		"Users": {
			"entity": "User",
			"actions": ["findById", "findByEmail", "create"]
		},
		"Posts": {
			"entity": "Post",
			"actions": [
				"findById",
				"findMany",
				"findPage",
				"create",
				"update",
				"delete"
			],
			"deletion": "soft",
			"relations": ["Users"]
		}
	},
	"exceptions": {
		"UserAlreadyExists": {
			"layer": "use-case",
			"message": "A user with this email already exists."
		},
		"InvalidCredentials": {
			"layer": "use-case",
			"message": "Wrong email or password."
		},
		"PostNotFound": {
			"layer": "use-case",
			"message": "Post not found."
		}
	},
	"useCases": {
		"Register": {
			"generic": "register",
			"repository": "Users",
			"description": "Signs a user up.",
			"options": {
				"as": "user",
				"errors": {
					"conflict": "UserAlreadyExists"
				}
			}
		},
		"Login": {
			"generic": "login",
			"repository": "Users",
			"description": "Checks credentials.",
			"options": {
				"as": "user",
				"errors": {
					"invalid": "InvalidCredentials"
				}
			}
		},
		"CreatePost": {
			"generic": "create",
			"repository": "Posts",
			"description": "Writes a draft as the caller.",
			"options": {
				"as": "post",
				"omit": ["publishedAt"],
				"values": {
					"status": "draft"
				},
				"owner": {
					"key": "author",
					"context": "userId"
				},
				"errors": {
					"owner": "InvalidCredentials"
				}
			}
		},
		"Publish": {
			"generic": "publish",
			"repository": "Posts",
			"description": "Publishes a post of the caller.",
			"options": {
				"as": "post",
				"owner": {
					"key": "author",
					"context": "userId"
				},
				"set": {
					"status": "published"
				},
				"errors": {
					"notFound": "PostNotFound"
				}
			}
		},
		"ListPosts": {
			"generic": "list",
			"repository": "Posts",
			"description": "A page of posts."
		},
		"DeletePost": {
			"generic": "delete",
			"repository": "Posts",
			"description": "Deletes a post of the caller.",
			"options": {
				"as": "post",
				"owner": {
					"key": "author",
					"context": "userId"
				},
				"errors": {
					"notFound": "PostNotFound"
				}
			}
		}
	},
	"commands": {
		"Accounts": {
			"useCases": {
				"register": "Register",
				"login": "Login"
			},
			"transaction": true
		},
		"Blog": {
			"useCases": {
				"createPost": "CreatePost",
				"publish": "Publish",
				"listPosts": "ListPosts",
				"deletePost": "DeletePost"
			},
			"transaction": true
		}
	},
	"outputs": {
		"Api": {
			"commands": ["Accounts", "Blog"],
			"statuses": {
				"UserAlreadyExists": 409,
				"InvalidCredentials": 401,
				"PostNotFound": 404
			},
			"pipe": [
				{
					"sink": "hono",
					"options": {
						"basePath": "/api",
						"route": {
							"Blog.listPosts": {
								"method": "get"
							}
						},
						"docs": {
							"path": "/openapi.json",
							"info": {
								"title": "Blog",
								"version": "1.0.0"
							}
						},
						"context": {
							"headers": {
								"userId": "x-user-id"
							}
						}
					}
				}
			]
		}
	}
}
