    "useCases": {
      "additionalProperties": false,
      "description": "Use cases, by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "context": {
              "anyOf": [
                {
                  "description": "The name of a declared blueprint.",
                  "pattern": "^[A-Z][A-Za-z0-9]*$",
                  "type": "string",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "additionalProperties": false,
                      "description": "Fields by key.",
                      "patternProperties": {
                        "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                          "$ref": "#/$defs/Field",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "required": [
                    "fields",
                  ],
                  "type": "object",
                },
              ],
              "description": "A blueprint by name ("RegisterInput") or declared in place ({ "fields": {...} }).",
            },
            "dependencies": {
              "description": "Key -> name of a declared use case, repository or environment.",
              "patternProperties": {
                "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                  "type": "string",
                },
              },
              "type": "object",
            },
            "deprecated": {
              "default": false,
              "type": "boolean",
            },
            "description": {
              "type": "string",
            },
            "errors": {
              "description": "Declared exceptions, or exceptions exported by @afora/core (afora_catalog coreExceptions), a caller should expect.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "implementation": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "steps": {
                      "items": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "args": {
                                "anyOf": [
                                  {
                                    "items": {
                                      "description": "A value: a "$reference" ($input.key, $context.key, $env.dep.VAR, $name.path), a JSON literal ({ "literal": "$5" } escapes a string that starts with $) or a mapping of values. No expressions.",
                                    },
                                    "type": "array",
                                  },
                                  {
                                    "pattern": "^\\$",
                                    "type": "string",
                                  },
                                ],
                                "description": "The arguments: a list of values, or one "$reference" to a list, which is spread.",
