              "type": "boolean",
            },
          },
          "required": [
            "fields",
          ],
          "type": "object",
        },
      ],
      "description": "A field of a blueprint, record, entity or environment.",
    },
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
    },
    "blueprints": {
      "additionalProperties": false,
      "description": "Object shapes without identity, by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "fields": {
              "additionalProperties": false,
              "description": "Fields by key.",
              "patternProperties": {
                "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                  "$ref": "#/$defs/Field",
                },
              },
              "type": "object",
            },
          },
          "required": [
            "fields",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "commands": {
      "additionalProperties": false,
      "description": "Commands (commandOf), by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "context": {
              "anyOf": [
                {
                  "description": "The name of a declared blueprint.",
                  "pattern": "^[A-Z][A-Za-z0-9]*$",
                  "type": "string",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fields": {
                      "additionalProperties": false,
                      "description": "Fields by key.",
                      "patternProperties": {
                        "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                          "$ref": "#/$defs/Field",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "required": [
                    "fields",
                  ],
                  "type": "object",
                },
              ],
              "description": "A blueprint by name ("RegisterInput") or declared in place ({ "fields": {...} }).",
            },
            "description": {
              "type": "string",
            },
            "environments": {
              "description": "Environments it depends on: command.env, the event handlers and the use cases that declare them get their variables.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "events": {
              "anyOf": [
                {
                  "const": "after-commit",
                  "type": "string",
                },
                {
                  "const": "manual",
                  "type": "string",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "options": {
                      "description": "JSON options of the policy. publishEvents: { "publisher": "<key of publishers>", "topic": "posts/{id}", "events"?: [names], "handle"?: true, "onPublishError"?: "log" | "throw" }.",
                      "patternProperties": {
                        "^.*$": {},
                      },
                      "type": "object",
                    },
                    "policy": {
                      "description": "The name of an event policy of the catalog: "publishEvents" is built in; others come from the policies given to codegen (--policies).",
                      "type": "string",
                    },
                  },
                  "required": [
                    "policy",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "import": {
                      "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                      "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                      "type": "string",
                    },
                  },
                  "required": [
                    "import",
                  ],
                  "type": "object",
                },
              ],
              "default": "after-commit",
              "description": ""after-commit" (default), "manual", a policy of the catalog ({ "policy": "publishEvents", "options": { "publisher": "realtime", "topic": "posts/{id}" } }) or { "import": "./events.ts#dispatch" } (a handler written by hand).",
            },
            "onEventError": {
              "additionalProperties": false,
              "properties": {
                "import": {
                  "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                  "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                  "type": "string",
                },
              },
              "required": [
                "import",
              ],
              "type": "object",
            },
            "tags": {
              "description": "Tags, for documentation.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "transaction": {
              "default": false,
              "description": "Runs every call in a transaction of the provider of the repositories (checked when the code runs: the provider must support it).",
              "type": "boolean",
            },
            "useCases": {
              "description": "Operation name -> name of a declared use case (e.g. { "register": "Register" }).",
              "minProperties": 1,
              "patternProperties": {
                "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                  "type": "string",
                },
              },
              "type": "object",
            },
          },
          "required": [
            "useCases",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "entities": {
      "additionalProperties": false,
      "description": "Entities (a record plus id, createdAt, updatedAt, deletedAt), by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "change": {
              "description": "Keys that get a change.<key>(value) method.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "events": {
              "additionalProperties": false,
              "description": "Entities only: the events each cycle raises, generated as <Name>Events with eventOf. An event is a name ("created"), raised for a policy such as publishEvents, or { "name": "created", "handler": { "import": "./events.ts#onCreated" } }.",
              "properties": {
                "onCreate": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "description": "An event without a handler.",
                          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                          "type": "string",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "handler": {
                              "additionalProperties": false,
                              "properties": {
                                "import": {
                                  "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                  "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "import",
                              ],
                              "type": "object",
                            },
                            "name": {
                              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    {
                      "items": {
                        "anyOf": [
                          {
                            "description": "An event without a handler.",
                            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                            "type": "string",
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "handler": {
                                "additionalProperties": false,
                                "properties": {
                                  "import": {
                                    "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                    "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "import",
                                ],
                                "type": "object",
                              },
                              "name": {
                                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                                "type": "string",
                              },
                            },
                            "required": [
                              "name",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "minItems": 1,
                      "type": "array",
                    },
                  ],
                },
                "onDelete": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "description": "An event without a handler.",
                          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                          "type": "string",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "handler": {
                              "additionalProperties": false,
                              "properties": {
                                "import": {
                                  "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                  "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "import",
                              ],
                              "type": "object",
                            },
                            "name": {
                              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    {
                      "items": {
                        "anyOf": [
                          {
                            "description": "An event without a handler.",
                            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                            "type": "string",
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "handler": {
                                "additionalProperties": false,
                                "properties": {
                                  "import": {
                                    "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                    "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "import",
                                ],
                                "type": "object",
                              },
                              "name": {
                                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                                "type": "string",
                              },
                            },
                            "required": [
                              "name",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "minItems": 1,
                      "type": "array",
                    },
                  ],
                },
                "onUpdate": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "description": "An event without a handler.",
                          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                          "type": "string",
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "handler": {
                              "additionalProperties": false,
                              "properties": {
                                "import": {
                                  "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                  "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                  "type": "string",
                                },
                              },
                              "required": [
                                "import",
                              ],
                              "type": "object",
                            },
                            "name": {
                              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                              "type": "string",
                            },
                          },
                          "required": [
                            "name",
                          ],
                          "type": "object",
                        },
                      ],
                    },
                    {
                      "items": {
                        "anyOf": [
                          {
                            "description": "An event without a handler.",
                            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                            "type": "string",
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "handler": {
                                "additionalProperties": false,
                                "properties": {
                                  "import": {
                                    "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                                    "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "import",
                                ],
                                "type": "object",
                              },
                              "name": {
                                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
                                "type": "string",
                              },
                            },
                            "required": [
                              "name",
                            ],
                            "type": "object",
                          },
                        ],
                      },
                      "minItems": 1,
                      "type": "array",
                    },
                  ],
                },
              },
              "type": "object",
            },
            "expires": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "after": {
                      "additionalProperties": false,
                      "description": "A duration from createdAt, e.g. { "days": 400 }; the entity gets an expiresAt identity key.",
                      "minProperties": 1,
                      "properties": {
                        "days": {
                          "exclusiveMinimum": 0,
                          "type": "number",
                        },
                        "hours": {
                          "exclusiveMinimum": 0,
                          "type": "number",
                        },
                        "minutes": {
                          "exclusiveMinimum": 0,
                          "type": "number",
                        },
                        "seconds": {
                          "exclusiveMinimum": 0,
                          "type": "number",
                        },
                      },
                      "type": "object",
                    },
                  },
                  "required": [
                    "after",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "at": {
                      "description": "A date field (dateTime or date, optional or not) holding when the record expires; without a value it never does.",
                      "type": "string",
                    },
                  },
                  "required": [
                    "at",
                  ],
                  "type": "object",
                },
              ],
              "description": "Entities only: when their records expire, which reads then leave out (unless withExpired): { "after": { "days": 400 } } or { "at": "until" }. Unique keys still count expired records.",
            },
            "fields": {
              "additionalProperties": false,
              "description": "Fields by key.",
              "patternProperties": {
                "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                  "$ref": "#/$defs/Field",
                },
              },
              "type": "object",
            },
            "plugins": {
              "description": "Std record plugins: publishable, archivable, taggable, ownable, authenticatable.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "previousNames": {
              "description": "Entities only: the names the entity had before; app.migrate moves their rows and start({ lock }) accepts the rename.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "schemaVersion": {
              "description": "Entities only: the version of the stored shape (1 when absent). Rows store it under $v; reads bring older rows up through upgrade.",
              "minimum": 1,
              "type": "integer",
            },
            "sensitive": {
              "description": "Keys always masked by toJSON(); \`password\` properties already are.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "unique": {
              "description": "Keys that are unique (repositories get findBy<Key>); \`slug\` properties already are.",
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "upgrade": {
              "additionalProperties": false,
              "description": "Entities only: the hand-written step that brings a stored row up to each version: { "2": { "import": "./upgrades.ts#toV2" } }, each (data) => data. Keys from 2 to schemaVersion.",
              "patternProperties": {
                "^[1-9][0-9]*$": {
                  "additionalProperties": false,
                  "properties": {
                    "import": {
                      "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                      "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                      "type": "string",
                    },
                  },
                  "required": [
                    "import",
                  ],
                  "type": "object",
                },
              },
              "type": "object",
            },
            "versioned": {
              "description": "Entities only: adds a version identity key that update checks (optimistic concurrency, RepositoryConcurrencyConflict on a stale write) and bumps.",
              "type": "boolean",
            },
          },
          "required": [
            "fields",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "environments": {
      "additionalProperties": false,
      "description": "Environment variables, read from process.env, by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "fields": {
              "additionalProperties": false,
              "description": "Fields by key.",
              "patternProperties": {
                "^[A-Za-z_$][A-Za-z0-9_$]*$": {
                  "$ref": "#/$defs/Field",
                },
              },
              "type": "object",
            },
          },
          "required": [
            "fields",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "exceptions": {
      "additionalProperties": false,
      "description": "Exceptions (exceptionOf), by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "layer": {
              "description": "One of the exception layers: schema, property, blueprint, record, entity, use-case, repository, environment, event, command, application, output (see afora_catalog).",
              "type": "string",
            },
            "message": {
              "description": "The message. "<Name>." when omitted.",
              "type": "string",
            },
          },
          "required": [
            "layer",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "extends": {
      "description": "Other specs whose declarations this one uses: relative paths to their afora.json, or package names.",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "log": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "anyOf": [
                {
                  "const": "debug",
                  "type": "string",
                },
                {
                  "const": "info",
                  "type": "string",
                },
                {
                  "const": "warn",
                  "type": "string",
                },
                {
                  "const": "error",
                  "type": "string",
                },
              ],
              "description": "The lowest level kept; info by default.",
            },
            "providers": {
              "description": "Where the lines go: "console", "json" or { "import": "./file.ts#provider" }.",
              "items": {
                "anyOf": [
                  {
                    "const": "console",
                    "type": "string",
                  },
                  {
                    "const": "json",
                    "type": "string",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "import": {
                        "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                        "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                        "type": "string",
                      },
                    },
                    "required": [
                      "import",
                    ],
                    "type": "object",
                  },
                ],
              },
              "type": "array",
            },
          },
          "required": [
            "providers",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "import": {
              "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
              "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
              "type": "string",
            },
          },
          "required": [
            "import",
          ],
          "type": "object",
        },
      ],
      "description": "How the application logs: { "level", "providers" }, or { "import": "./file.ts#log" } for a log made by hand (logFrom).",
    },
    "name": {
      "description": "The name of the generated application.",
      "type": "string",
    },
    "output": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "description": "Where the code is generated, relative to the project. src/domain by default.",
          "type": "string",
        },
      },
      "required": [
        "dir",
      ],
      "type": "object",
    },
    "outputs": {
      "additionalProperties": false,
      "description": "Outputs (outputOf), by name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "additionalProperties": false,
          "properties": {
            "commands": {
              "description": "Names of declared commands.",
              "items": {
                "pattern": "^[A-Z][A-Za-z0-9]*$",
                "type": "string",
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true,
            },
            "pipe": {
              "description": "Transforms, then at most one sink as the last stage.",
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "options": {
                        "description": "JSON options of the stage factory.",
                        "patternProperties": {
                          "^.*$": {},
                        },
                        "type": "object",
                      },
                      "transform": {
                        "description": "A transform of the stage catalog (afora_catalog stages).",
                        "type": "string",
                      },
                    },
                    "required": [
                      "transform",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "options": {
                        "description": "JSON options of the stage factory.",
                        "patternProperties": {
                          "^.*$": {},
                        },
                        "type": "object",
                      },
                      "sink": {
                        "description": "A sink of the stage catalog; only the last stage.",
                        "type": "string",
                      },
                    },
                    "required": [
                      "sink",
                    ],
                    "type": "object",
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "import": {
                        "description": "A hand-written export: "./file.ts#name" or "package#name", relative to the output directory. Never evaluated by the validator.",
                        "pattern": "^[^#\\s]+#[A-Za-z_$][A-Za-z0-9_$]*$",
                        "type": "string",
                      },
                    },
                    "required": [
                      "import",
                    ],
                    "type": "object",
                  },
                ],
                "description": "{ "transform": name, "options"? }, { "sink": name, "options"? } or { "import": "./stages.ts#auth" } (a stage written by hand).",
              },
              "type": "array",
            },
            "statuses": {
              "description": "HTTP-style status by exception name (declared or exported by @afora/core).",
              "patternProperties": {
                "^.*$": {
                  "maximum": 599,
                  "minimum": 400,
                  "type": "integer",
                },
              },
              "type": "object",
            },
          },
          "required": [
            "commands",
            "pipe",
          ],
          "type": "object",
        },
      },
      "type": "object",
    },
    "properties": {
      "additionalProperties": false,
      "description": "Custom properties, by PascalCase name.",
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "base": {
                  "description": "A Std property (lowercase) or another declared property.",
                  "type": "string",
                },
                "optional": {
                  "type": "boolean",
                },
                "with": {
                  "description": "Options of the property: title, description, examples, deprecated, readOnly, writeOnly, default; min, max, pattern for strings; min, max, exclusiveMin, exclusiveMax, multipleOf for numbers. See afora_catalog for what each property takes.",
                  "patternProperties": {
                    "^.*$": {},
                  },
                  "type": "object",
                },
              },
              "required": [
                "base",
              ],
              "type": "object",
            },
            {
              "additionalProperties": false,
