exports[`snapshots blog 1`] = `
{
  "src/domain/application.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { applicationOf } from "@afora/core";
import { Address } from "./blueprints";
import { Post, User } from "./entities";
import { Database } from "./environments";
import { Age, Status } from "./properties";
import { Posts, Users } from "./repositories";

export const App = applicationOf({
	name: "blog",
	properties: { Age, Status },
	blueprints: { Address },
	entities: { Post, User },
	environments: { Database },
	repositories: { Posts, Users },
});
"
,
  "src/domain/blueprints.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { blueprintOf } from "@afora/core";

export const Address = blueprintOf((ctx) => ({
	street: ctx.string,
	zip: ctx.string({ pattern: "^\\\\d{5}-\\\\d{3}$" }),
}));
"
,
  "src/domain/entities.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { blueprintOf, entityOf, listOf, optionalOf } from "@afora/core";
import { Address } from "./blueprints";
import { Age, Status } from "./properties";

export class User extends entityOf(
	blueprintOf((ctx) => ({
		name: ctx.text,
		email: ctx.email,
		slug: ctx.slug,
		password: ctx.password,
		age: optionalOf(Age),
		address: Address,
		tags: ctx.list.string,
	})),
	{
		unique: ["email"],
		change: ["name"],
	},
) {}

export class Post extends entityOf(
	blueprintOf((ctx) => ({
		title: ctx.text,
		status: Status,
		author: User,
		coauthors: listOf(User),
	})),
) {}
"
,
  "src/domain/environments.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { blueprintOf, environmentOf } from "@afora/core";

export const Database = environmentOf(
	blueprintOf((ctx) => ({
		DATABASE_URL: ctx.url,
		PORT: ctx.integer,
	})),
);
"
,
  "src/domain/index.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

export * from "./application";
export * from "./blueprints";
export * from "./entities";
export * from "./environments";
export * from "./properties";
export * from "./repositories";
"
,
  "src/domain/properties.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { enumOf, Integer } from "@afora/core";

export const Age = Integer.with({ min: 0, max: 150, description: "In years" });

export const Status = enumOf(["draft", "published"]);
"
,
  "src/domain/repositories.ts": 
"// Generated by @afora/codegen from afora.json. Do not edit.

import { repositoryOf } from "@afora/core";
import { Post, User } from "./entities";
import { Database } from "./environments";

export const Users = repositoryOf({
	entity: User,
	actions: ["findById", "findByEmail", "findBySlug", "create", "update"],
	environmentDependencies: [Database],
});

export const Posts = repositoryOf({
	entity: Post,
	actions: ["findById", "findManyByAuthor", "create"],
	relations: [Users],
});
"
,
}
`;

