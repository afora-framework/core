{
	"name": "@afora/playground",
	"version": "0.0.1",
	"description": "Local TypeScript playground for @afora/core: the afora CLI with a Monaco editor, project-aware IntelliSense and Bun execution.",
	"keywords": [
		"afora",
		"playground",
		"typescript",
		"editor",
		"cli"
	],
	"author": "Alan Reis <alanreisanjo@gmail.com> (https://github.com/Hoyasumii)",
	"license": "MIT",
	"homepage": "https://github.com/Hoyasumii/afora/tree/main/packages/playground#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hoyasumii/afora.git",
		"directory": "packages/playground"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"bin": {
		"afora": "./dist/server.js"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"typecheck": "bun check",
		"build": "rm -rf dist && bun scripts/build.ts",
		"dev": "bun scripts/build.ts && bun dist/server.js --project ../.. --source",
		"test": "bun test ./src/runner.test.ts ./src/scheduler.test.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"monaco-editor": "0.52.2",
		"typescript-language-service": "npm:typescript@5.9.3"
	},
	"peerDependencies": {
		"@afora/core": ">=0.0.2"
	}
}
