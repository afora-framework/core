{
	"name": "@afora/core",
	"version": "0.0.2",
	"description": "Domain modeling on TypeBox: entities with invariants, repositories, use cases, sensitive data masking and layered exceptions, usable by any Standard Schema consumer.",
	"keywords": [
		"domain-driven-design",
		"ddd",
		"domain-model",
		"entity",
		"value-object",
		"repository",
		"use-case",
		"typebox",
		"standard-schema",
		"validation",
		"schema",
		"typescript",
		"bun"
	],
	"author": "Alan Reis <alanreisanjo@gmail.com> (https://github.com/Hoyasumii)",
	"license": "MIT",
	"homepage": "https://github.com/Hoyasumii/afora#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hoyasumii/afora.git"
	},
	"bugs": {
		"url": "https://github.com/Hoyasumii/afora/issues"
	},
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"bin": {
		"afora": "./dist/playground/server.js"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"typecheck": "bun check",
		"lint": "biome lint .",
		"fmt": "biome check --write .",
		"knip": "knip",
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external && tsc -p tsconfig.build.json",
		"postbuild": "bun scripts/add-dts-extensions.ts && bun playground/build.ts",
		"playground": "bun playground/build.ts && bun dist/playground/server.js --source",
		"test:playground": "bun test ./playground/runner.test.ts",
		"bench": "cd bench && bun install && bun run.ts",
		"smoke": "bun run build && node scripts/smoke.mjs",
		"test:types": "bun run build && bun tests/types-compat/run.ts",
		"test:type-perf": "bun run build && bun test ./tests/type-perf",
		"test:interop": "cd examples/interop && bun install && bun test",
		"prepare": "husky",
		"prepublishOnly": "bun run typecheck && bun test && bun run smoke",
		"test:codegen": "bun test --cwd packages/codegen",
		"test:mcp": "bun test --cwd packages/mcp",
		"build:packages": "bun run build && bun run --cwd packages/codegen build && bun run --cwd packages/mcp build"
	},
	"dependencies": {
		"slugify": "^1.6.9",
		"typebox": "^1.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/bun": "^1.4.4",
		"husky": "^9.1.7",
		"knip": "^6.43.0",
		"monaco-editor": "0.52.2",
		"typescript": "^7.0.2",
		"typescript-language-service": "npm:typescript@5.9.3"
	},
	"peerDependencies": {
		"typescript": ">=5.5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"overrides": {
		"@afora/core": "link:."
	}
}
