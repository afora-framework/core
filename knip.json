{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["examples/**"],
	"ignoreBinaries": ["run.ts"],
	"tags": ["-@internal"],
	"workspaces": {
		".": {
			"entry": [
				"src/index.ts",
				"src/adapters.ts",
				"src/experimental.ts",
				"src/testing/index.ts",
				"src/**/*.sandbox.ts",
				"scripts/*.{ts,mjs}"
			],
			"project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
		},
		"packages/codegen": {
			"entry": [
				"src/index.ts",
				"src/cli.ts",
				"scripts/*.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "scripts/*.ts", "tests/**/*.ts"]
		},
		"packages/hono": {
			"entry": ["src/index.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"packages/fastify": {
			"entry": ["src/index.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"packages/express": {
			"entry": ["src/index.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"packages/elysia": {
			"entry": ["src/index.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"packages/ws": {
			"entry": ["src/index.ts", "tests/**/*.test.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		},
		"packages/drizzle": {
			"entry": ["src/index.ts", "src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/dynamodb": {
			"entry": ["src/index.ts", "src/**/*.test.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/mcp": {
			"entry": [
				"src/index.ts",
				"src/bin.ts",
				"src/extract-child.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		}
	}
}
