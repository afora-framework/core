{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["examples/**"],
	"ignoreBinaries": ["run.ts"],
	"workspaces": {
		".": {
			"entry": [
				"src/index.ts",
				"src/**/*.sandbox.ts",
				"scripts/*.{ts,mjs}"
			],
			"project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
		},
		"packages/codegen": {
			"entry": [
				"src/index.ts",
				"src/cli.ts",
				"scripts/*.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "scripts/*.ts", "tests/**/*.ts"]
		},
		"packages/mcp": {
			"entry": [
				"src/index.ts",
				"src/bin.ts",
				"src/extract-child.ts",
				"tests/**/*.test.ts"
			],
			"project": ["src/**/*.ts", "tests/**/*.ts"]
		}
	}
}
